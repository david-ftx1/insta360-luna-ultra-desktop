<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    macOS 15+ Local Network Privacy: connecting to the camera at 192.168.42.1
    counts as local-network access and is blocked until the user grants
    permission. This string is shown in that system prompt.
  -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Luna Ultra Desktop connects to your Insta360 Luna Ultra camera over your local Wi-Fi network to browse and download your photos and videos.</string>
  <!-- The app saves downloaded media into ~/Downloads/Luna Ultra, which macOS
       gates behind a one-time Downloads-folder prompt. -->
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Luna Ultra Desktop saves the photos and videos you download from your camera into your Downloads folder.</string>
  <!-- The Gallery/Live View preview loads the camera's media (LRV proxies,
       stills, the MJPEG/H.264 live feed) directly into <video>/<img> elements
       over plain HTTP, since the camera itself has no HTTPS. WKWebView's App
       Transport Security blocks plain HTTP by default; this exception scopes
       that allowance to local-network addresses only (private IPs, .local
       hosts) rather than disabling ATS for the whole app. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
